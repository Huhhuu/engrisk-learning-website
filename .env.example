APP_NAME="English-Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL (LARAGON)
# Mặc định Laragon: Host 127.0.0.1, Port 3306, User root, Mật khẩu rỗng
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=english_learning
DB_USERNAME=root
DB_PASSWORD=

# Quản lý phiên làm việc (Session) lưu trong CSDL MySQL
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ==============================================================================
# CẤU HÌNH BỘ NHỚ ĐỆM & HÀNG ĐỢI (CACHE & QUEUE)
# Laragon local: Lưu file và xử lý sync tức thì (không cần cài thêm Redis)
# ==============================================================================
FILESYSTEM_DISK=local
CACHE_STORE=file
QUEUE_CONNECTION=sync
DB_QUEUE_RETRY_AFTER=360

# ==============================================================================
# CẤU HÌNH GỬI EMAIL (MAILPIT CỦA LARAGON)
# Laragon tích hợp sẵn Mailpit tại cổng 1025, xem thư ảo tại http://localhost:8025
# ==============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cấu hình dịch vụ mở rộng (Để trống nếu chạy offline / mock)
LEXILINGO_BACKEND_URL=
LEXILINGO_AI_URL=
LEXILINGO_PARTNER_API_KEY=
LEXILINGO_AI_SERVICE_SECRET=
LEXILINGO_TRACE_CAG_SERVICE_TOKEN=
LEXILINGO_SUBJECT_HMAC_SECRET=
LEXILINGO_TIMEOUT=30
LEXILINGO_CONNECT_TIMEOUT=5
LEXILINGO_IMPORT_DELAY_MS=250
LEXILINGO_IMPORT_MAX_RETRIES=3
LEXILINGO_IMPORT_MAX_BACKOFF_MS=10000
LEXILINGO_AI_RETRY_TIMES=2
LEXILINGO_AI_RETRY_DELAY_MS=200
LEXILINGO_MAX_AUDIO_KB=10240

# Google Gemini: dịch Việt ⇄ Anh và tạo flashcard theo chủ đề (cần FEATURE_AI=true)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

FEATURE_LEXILINGO_IMPORT=false
FEATURE_LEXILINGO_IMPORT_APPLY=false
FEATURE_AI=false
FEATURE_VOICE=false
FEATURE_YOUTUBE_LISTENING=false
FEATURE_SUPERVISION=false
FEATURE_OPERATIONS=false

# Cấu hình mạng xã hội / Google Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
ADMIN_GOOGLE_EMAILS=admin@example.com
SUPER_ADMIN_GOOGLE_EMAILS=admin@example.com

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8080/auth/facebook/callback
